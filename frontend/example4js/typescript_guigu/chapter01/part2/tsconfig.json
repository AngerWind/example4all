{
/*
  tsconfig.json是ts编译器的配置文件，ts编译器可以根据它的信息来对代码进行编译
    "include" 用来指定哪些ts文件需要被编译
      路径：** 表示任意目录
            * 表示任意文件
    "exclude" 不需要被编译的文件目录
        默认值：["node_modules", "bower_components", "jspm_packages"]

*/
  "include": [
    "./src/**/*"
  ],
//  "exclude": [
//    "./src/hello/**/*"
//  ]

  /*
    compilerOptions 编译器的选项
  */
  "compilerOptions": {

    /**
     target 指定ts被编译为js后, js使用的语法的版本, 可选值有: 'es3', 'es5', 'es6', 'es2015', 'es2016', 'es2017', 'es2018', 'es2019', 'es2020', 'esnext'
     比如如下代码
     const fn = () => console.log('hello');
     async function getData() {
       const res = await fetch('/api');
     }
     如果指定es5, 那么const fn = () => console.log('hello'); 会被转换为 var fn = function(){...}, async/await 转换为generator
     如果指定es2015的话, 那么const fn = () => {} 被保留, 但是async / await 转换为generator
     如果指定es2022的话, 那么async/await也会被保留
    */
    "target": "es2015",
    /**
        module指定ts被编译为js后, 要使用的模块系统, 可选值有: 'none', 'commonjs', 'amd', 'system', 'umd', 'es6', 'es2015', 'es2020', 'esnext'
        这个根据你实际运行的环境来选择

        比如如下的代码
        import axios from 'axios';
        export const name = 'hello';
        如果是commonjs, 那么会被转换为require("axios")
        如果是es2015/esnext, 会被转换为 import axios from "axios"
    */
    "module": "es2015",
    /**
        告诉ts, 在编译的适合, 有哪些全局的api可用
        如果指定es5, 那么Array, Object, JSON等基础api可用
        如果指定es2015, 那么Promise, Map, Set, Symbol可用
        如果es2022, 那么BigInt, Promise.allSettled, 可选链 可用
        如果DOM, 那么document, window, HTMLElement, fetch可用

        lib会根据target来自动选择, 但是不包含DOM, 如果是前端项目的话, 需要手动加DOM
    */
    /**
        常见的组合如下
        ┌──────────────────┬────────┬──────────┬───────────────────────────┐
        │       场景        │ target │  module  │            lib            │
        ├──────────────────┼────────┼──────────┼───────────────────────────┤
        │ Node.js 项目      │ ES2020 │ CommonJS │ ES2020                    │
        ├──────────────────┼────────┼──────────┼───────────────────────────┤
        │ 前端项目（Vite）    │ ESNext │ ESNext   │ ESNext, DOM, DOM.Iterable │
        ├──────────────────┼────────┼──────────┼───────────────────────────┤
        │ 兼容旧浏览器       │ ES5    │ ESNext   │ ES2020, DOM               │
        └──────────────────┴────────┴──────────┴───────────────────────────┘
    */
    "lib": ["es6", "dom"],


    // 指定编译后文件所在的目录
    // 例如 src/a.ts → dist/a.js
    "outDir": "./dist",

    // 将代码合并为一个文件
    // 仅支持 AMD 和 System 模块系统，使用 CommonJS/ESNext 时会报错
    // 设置后，所有全局作用域中的代码会合并到同一个文件中
    // "outFile": "./dist/app.js"

    // ========== 编译行为 ==========

    // 是否对 js 文件进行编译，默认 false
    // 开启后 .js 文件也会被 TS 编译器处理并输出到 outDir
    // 在实际开发中, 都有vite/webpack这些打包工具, 他们自己处理文件的引用和编译, 不关心是不是需要将ts也输出到outDir中, 所以设不设置这个都无所谓
    // 只有在纯tsc项目中, 如果你的代码中有js, 就设置为true, 如果完全是ts代码, 就设置为false
    // "allowJs": true,

    // 是否检查 js 文件是否符合 TS 语法规范，默认 false
    // 需要配合 allowJs 使用，可以在 .js 文件中也进行类型检查
    // "checkJs": true,

    // 是否移除注释，默认 false
    // 开启后编译输出的 .js 文件中不包含源码中的注释
    "removeComments": true,

    // 只执行编译但不生成编译后的 js 文件，默认 false
    // 适合配合 Babel/esbuild 等工具使用，TS 只做类型检查，编译交给其他工具
    // Vite 项目中通常设为 true
    "noEmit": false,

    // 当有类型错误时不生成编译后的文件，默认 false
    // 开启后，只要有任何 TS 错误就不会输出 .js 文件
    "noEmitOnError": true,

    // ========== 严格检查 ==========

    // 所有严格检查的总开关，默认 false
    // 开启后相当于同时开启以下所有 strict 系列选项：
    // strictNullChecks, noImplicitAny, noImplicitThis,
    // alwaysStrict, strictBindCallApply, strictFunctionTypes,
    // strictPropertyInitialization, useUnknownInCatchVariables
    "strict": true,

    // 编译后的文件是否添加 "use strict"，默认 false
    // 开启后每个编译输出的 .js 文件顶部会有 "use strict"
    "alwaysStrict": true,

    // 不允许隐式的 any 类型，默认 false
    // 关闭时: function fn(a) {}          // a 是 any，不报错
    // 开启时: function fn(a) {}          // ❌ 报错：参数 a 隐式具有 any 类型
    // 修正:   function fn(a: string) {}  // ✅ 显式标注类型
    "noImplicitAny": true,

    // 不允许不明确类型的 this，默认 false
    // 关闭时:
    //   function fn() { console.log(this.name) }  // 不报错
    // 开启时:
    //   function fn() { console.log(this.name) }  // ❌ 报错：this 隐式具有 any 类型
    // 修正:
    //   function fn(this: { name: string }) { console.log(this.name) }  // ✅
    "noImplicitThis": true,

    // 严格的空值检查，默认 false
    // 关闭时:
    //   let a: number = null;     // ✅ 不报错
    //   let b: string = undefined; // ✅ 不报错
    // 开启时:
    //   let a: number = null;      // ❌ 报错：不能将 null 赋值给 number
    //   let b: string = undefined; // ❌ 报错：不能将 undefined 赋值给 string
    // 修正:
    //   let a: number | null = null;       // ✅
    //   let b: string | undefined = undefined; // ✅
    "strictNullChecks": true


  }
}